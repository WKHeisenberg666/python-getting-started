# This file specifies environment variables for local development. It's loaded
# automatically both by `heroku local` and by plain `python manage.py ...`/`gunicorn`
# (via python-dotenv in gettingstarted/settings.py). It has no effect on apps running on
# Heroku - to set env vars for those, see: https://devcenter.heroku.com/articles/config-vars

TIMES=2

# Finanz-Dashboard (see README.md "Finanz-Dashboard" section) - fill in for real usage,
# never commit real secrets here.
PROTON_DRIVE_SYNC_FOLDER=/Users/marcel/Library/CloudStorage/ProtonDrive-marcel.peters@proton.me-folder/Forderungen 2026
PROTON_DRIVE_EXCLUDE_SUBFOLDERS=dashboard,venv
DEBT_EXCEL_EXPORT_PATH=media/schuldenliste.xlsx

# Eigener Anthropic-API-Key für die Dokumenten-Analyse (console.anthropic.com) - ohne diesen
# Key liest sync_drive_folder keine Beträge/Gläubiger aus Dokumenten.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
# GOCARDLESS_SPARKASSE_REQUISITION_ID=
# GOCARDLESS_REVOLUT_REQUISITION_ID=
